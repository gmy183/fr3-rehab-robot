def valid_state(driver, attempts=10):

    last = "unknown"

    for _ in range(attempts):

        fresh = driver.read_fresh_state(
            force_update=True
        )

        if fresh is None:
            last = "no fresh state"
            time.sleep(0.01)
            continue

        fs = fresh.state.finger_state

        if len(fs) != 12:
            last = f"joint count={len(fs)}"
            time.sleep(0.01)
            continue

        q = []
        current = []
        raw = []

        for i, f in enumerate(fs):

            errors = (
                int(f.commboard_err),
                int(f.jonitboard_err),
                int(f.tipboard_err),
            )

            if any(errors):
                raise RuntimeError(
                    f"{NAMES[i]} errors={errors}"
                )

            q.append(float(f.position))
            current.append(float(f.torque))
            raw.append(int(f.raw_position))

        # 拒绝 EtherCAT 启动/运行中的默认零状态
        if any(v == 0 for v in raw):
            last = "raw_position zero/default frame"
            time.sleep(0.01)
            continue

        if (
            all(abs(v) < 1e-12 for v in q)
            and all(abs(v) < 1e-12 for v in current)
        ):
            last = "all-zero default frame"
            time.sleep(0.01)
            continue

        return q, current

    raise RuntimeError(
        "no semantically valid state: "
        + last
    )


def baseline(driver):

    rows = []

    deadline = time.monotonic() + 2.0

    while (
        len(rows) < 15
        and time.monotonic() < deadline
    ):

        try:
            q, _ = valid_state(driver)
            rows.append(q)
        except RuntimeError as exc:
            if "errors=" in str(exc):
                raise

        time.sleep(0.01)

    if len(rows) < 15:
        raise RuntimeError(
            "baseline acquisition failed"
        )

    q0 = [
        statistics.median(
            row[i]
            for row in rows
        )
        for i in range(12)
    ]

    spans = [
        max(row[i] for row in rows)
        - min(row[i] for row in rows)
        for i in range(12)
    ]

    if max(spans) > 0.020:
        raise RuntimeError(
            f"baseline unstable: "
            f"{max(spans):.6f}"
        )

    print(
        f"[PASS] baseline "
        f"worst_span={max(spans):.6f}"
    )

    return q0


def make_command(reference, target, enabled):

    enabled = set(enabled)

    specs = []

    for i in range(12):

        if i in enabled:

            specs.append(
                JointCommandSpec(
                    position=float(target[i]),
                    effort_limit=TOR_MAX,
                    mode=MODE,
                    kp=KP,
                    ki=KI,
                    kd=KD,
                )
            )

        else:

            specs.append(
                JointCommandSpec(
                    position=float(reference[i]),
                    effort_limit=0,
                    mode=0,
                    kp=0,
                    ki=0,
                    kd=0,
                )
            )

    return build_command(specs)


def check_sample(
    q,
    current,
    previous_q,
    target,
    enabled,
):

    for i in enabled:

        if abs(current[i]) > CURRENT_GUARD:
            raise RuntimeError(
                f"{NAMES[i]} current="
                f"{current[i]:+.1f}mA"
            )

        jump = (
            q[i]
            - previous_q[i]
        )

        if abs(jump) > JUMP_GUARD:
            raise RuntimeError(
                f"{NAMES[i]} sensor jump="
                f"{jump:+.6f}rad"
            )

        error = (
            target[i]
            - q[i]
        )

        if abs(error) > TRACKING_GUARD:
            raise RuntimeError(
                f"{NAMES[i]} tracking error="
                f"{error:+.6f}rad"
            )


def staged_takeover(driver, q0):

    enabled = []

    print()
    print("========== STAGED TAKEOVER ==========")

    for stage, index in enumerate(
        ACTIVE,
        start=1,
    ):

        enabled.append(index)

        target = list(q0)

        command = make_command(
            q0,
            target,
            enabled,
        )

        deadline = (
            time.monotonic()
            + 0.40
        )

        previous_q = list(q0)

        while time.monotonic() < deadline:

            start = time.monotonic()

            driver.refresh_active_command(
                command
            )

            time.sleep(0.020)

            q, current = valid_state(
                driver
            )

            check_sample(
                q,
                current,
                previous_q,
                target,
                enabled,
            )

            previous_q = q

            driver.poll_watchdog()

            elapsed = (
                time.monotonic()
                - start
            )

            if elapsed < DT:
                time.sleep(
                    DT - elapsed
                )

        print(
            f"[PASS] TAKEOVER "
            f"{stage}/10 "
            f"{NAMES[index]}"
        )


def move_to(
    driver,
    start_target,
    destination,
    reference,
    label,
):

    target = list(start_target)

    previous_q, _ = valid_state(
        driver
    )

    cycle = 0

    print()
    print(
        f"========== {label} =========="
    )

    while True:

        cycle += 1

        complete = True

        for i in ACTIVE:

            goal = destination[i]

            diff = (
                goal
                - target[i]
            )

            if abs(diff) > 1e-6:

                complete = False

                step = max(
                    -MAX_STEP,
                    min(MAX_STEP, diff)
                )

                target[i] += step

        command = make_command(
            reference,
            target,
            ACTIVE,
        )

        start = time.monotonic()

        driver.refresh_active_command(
            command
        )

        time.sleep(0.020)

        q, current = valid_state(
            driver
        )

        check_sample(
            q,
            current,
            previous_q,
            target,
            ACTIVE,
        )

        previous_q = q

        driver.poll_watchdog()

        if cycle % 20 == 0:

            max_error = max(
                abs(target[i] - q[i])
                for i in ACTIVE
            )

            max_current = max(
                abs(current[i])
                for i in ACTIVE
            )

            print(
                f"{label}: "
                f"cycle={cycle} "
                f"max_err={max_error:.4f}rad "
                f"max_I={max_current:.1f}mA"
            )

        if complete:

            break

        elapsed = (
            time.monotonic()
            - start
        )

        if elapsed < DT:
            time.sleep(
                DT - elapsed
            )

    # 最终目标保持 1 秒
    command = make_command(
        reference,
        target,
        ACTIVE,
    )

    deadline = (
        time.monotonic()
        + 1.0
    )

    while time.monotonic() < deadline:

        start = time.monotonic()

        driver.refresh_active_command(
            command
        )

        time.sleep(0.020)

        q, current = valid_state(
            driver
        )

        check_sample(
            q,
            current,
            previous_q,
            target,
            ACTIVE,
        )

        previous_q = q

        driver.poll_watchdog()

        elapsed = (
            time.monotonic()
            - start
        )

        if elapsed < DT:
            time.sleep(
                DT - elapsed
            )

    final_error = max(
        abs(target[i] - q[i])
        for i in ACTIVE
    )

    print(
        f"[PASS] {label} "
        f"final_max_error="
        f"{final_error:.6f}rad"
    )

    return list(target)


